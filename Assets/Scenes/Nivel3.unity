--- !u!1001 &1642061228
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 802069781}
    m_Modifications:
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].text
      value: "Ya es de noche, {jugadora}. Hay 6 mascotas que llevan d\xEDas en la calle: est\xE1n sucias y llenas de moscas."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[1].text
      value: "Puedo ba\xF1arlas. \xBFCon cualquier jab\xF3n?"
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[2].text
      value: "No. Usa jab\xF3n para mascotas; el de personas les irrita la piel. Con cada jab\xF3n ba\xF1a a una mascota pulsando E."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[3].text
      value: "Para ba\xF1arlas frota r\xE1pido alternando \u2190 y \u2192, y luego s\xE9calas bien. Coco, Kira y Mota se asustan si corres: ac\xE9rcate despacio."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[4].text
      value: "Cuidado con las pelotas y patinetas que ruedan por la calle. \xA1Salta para esquivarlas!"
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[5].text
      value: "\xA1Voy por ellas!"
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.a
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.b
