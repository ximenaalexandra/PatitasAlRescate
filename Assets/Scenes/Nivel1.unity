--- !u!1001 &319909018
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1190833793}
    m_Modifications:
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].text
      value: "\xA1Hola, {jugadora}! Soy la Dra. Luc\xEDa, veterinaria del refugio Patitas."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[1].text
      value: "\xA1Hola, doctora! Vine a ayudar. \xBFQu\xE9 est\xE1 pasando en el barrio?"
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[2].text
      value: "Hay 2 perritos y 2 gatitos heridos en la calle. Est\xE1n acostados, sin fuerzas y tienen una cruz roja encima."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[3].text
      value: "Recoge botiquines (algunos est\xE1n en lo alto: salta con Espacio). Con un botiqu\xEDn, ac\xE9rcate a cada mascota y pulsa E."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[4].text
      value: "\xBFY c\xF3mo las curo?"
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[5].text
      value: "En tres pasos: elige con qu\xE9 limpiar la herida (1, 2 o 3), l\xEDmpiala repitiendo las flechas y pon la venda con Espacio en el momento justo."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[6].text
      value: "Si te equivocas pierdes tiempo, as\xED que hazlo con calma. Cada vez que cures a una te contar\xE9 por qu\xE9 es tan importante."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.a
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.b
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.g
      value: 0.85
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.r
      value: 0.55
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].speakerName
      value: "Dra. Luc\xEDa"
