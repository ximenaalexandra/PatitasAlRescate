    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: 'respuestasIncorrectas.Array.data[0]'
      value: Dejarla en la calle
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: 'respuestasIncorrectas.Array.data[1]'
