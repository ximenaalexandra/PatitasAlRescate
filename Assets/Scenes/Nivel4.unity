      propertyPath: nombreFamilia
      value: Paula
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: respuestaCorrecta
      value: Buscarle un refugio o un hogar responsable
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: sinCollar.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.data[0].text
      value: "\xA1Gracias, {jugadora}! Le daremos mucho amor."
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: sinCollar.Array.data[0].text
      value: "\xA1Qu\xE9 linda mascota! Pero necesita su collar con placa antes de venir a casa. \xBFLo traes?"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[0].text
      value: "\xA1Hola! Quiero adoptar, pero vivo en un apartamento."
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[1].text
      value: Muchas mascotas viven felices en apartamento si reciben tiempo, juego y paseos.
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[2].text
      value: "Le dedicar\xE9 tiempo todos los d\xEDas y ya le compr\xE9 su cama."
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[3].text
      value: "Entonces ser\xE1 muy feliz contigo. \xA1Aqu\xED est\xE1 su collar!"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: respuestasIncorrectas.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.data[0].nameColor.a
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.data[0].nameColor.b
      value: 0.75
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.data[0].nameColor.g
