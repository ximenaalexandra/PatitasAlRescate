      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 436659522025904338, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2079181318905345723, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: m_Name
      value: "Familia_Do\xF1aMarta"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: pregunta
      value: "Do\xF1a Marta pregunta: \xBFqu\xE9 necesita la mascota adem\xE1s de comida?"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: explicacion
      value: "Una mascota necesita compa\xF1\xEDa, juego, paseos y controles veterinarios."
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: nombreFamilia
      value: "Do\xF1a Marta"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: sinCollar.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.data[0].text
      value: "\xA1Gracias, {jugadora}! Le daremos mucho amor."
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: sinCollar.Array.data[0].text
      value: "\xA1Qu\xE9 linda mascota! Pero necesita su collar con placa antes de venir a casa. \xBFLo traes?"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[0].text
      value: "\xA1Buenas! Vivo sola desde que se fueron mis hijos y quiero compa\xF1\xEDa."
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[1].text
      value: "Esta mascota es muy tranquila. \xBFPodr\xE1 dedicarle tiempo todos los d\xEDas?"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[2].text
      value: "\xA1Claro! Estoy en casa casi todo el d\xEDa. La cuidar\xE9 mucho."
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: conversacion.Array.data[3].text
      value: "Aqu\xED tiene su collar con placa. \xA1Gracias por adoptar!"
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: respuestasIncorrectas.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8144013562851948799, guid: b1affe57705ad99429c29b68100f25dc, type: 3}
      propertyPath: despues.Array.data[0].nameColor.a
