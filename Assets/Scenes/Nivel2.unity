--- !u!1001 &1751865342
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1888158982}
    m_Modifications:
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].text
      value: "\xA1Buen trabajo con los heridos, {jugadora}! Ahora hay 2 perritos y 3 gatitos con mucha hambre."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[1].text
      value: "\xA1Pobrecitos! Los gatos est\xE1n maullando y los perritos est\xE1n pidiendo comida."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[2].text
      value: "Recoge los paquetes de alimento. Con E eliges su comida, sirves la porci\xF3n justa con Espacio y le das agua fresca."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[3].text
      value: "Recuerda: los gatos necesitan alimento para gatos y los perros alimento para perros. \xA1Nunca chocolate ni uvas!"
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[4].text
      value: "Pelusa y Lola son miedosas: si corres o saltas cerca de ellas, huyen. Ac\xE9rcate caminando."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[5].text
      value: "\xA1Ojo con la pelota que rueda por la calle! S\xE1ltala con Espacio."
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.a
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.b
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.g
      value: 0.85
      objectReference: {fileID: 0}
    - target: {fileID: 1752286456666053654, guid: 6ee02ace914181b4093b6a05e14a7e7e, type: 3}
      propertyPath: conversacion.Array.data[0].nameColor.r
      value: 0.55
      objectReference: {fileID: 0}
